# Copy this file to .env and paste your own key. .env is never committed.
COINGECKO_API_KEY=your-demo-key-here
# Local Postgres from docker-compose.yml. Leave this pointing at Docker: the Neon URL lives in
# .neon-url (never committed) and in the DATABASE_URL secret on GitHub.
DATABASE_URL=postgresql+psycopg://crypto:crypto@localhost:5432/crypto
